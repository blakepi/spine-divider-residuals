  "calculation_rules": {
    "rho_L_source_native": "R_neck_MOhm / load_value_MOhm when both are available",
    "Gamma_div_source_native": "1 / (1 + rho_L_source_native)",
    "rho_L_class_source_native": {
      "low_lt_0p25": "rho_L < 0.25",
      "intermediate_0p25_to_lt_0p75": "0.25 <= rho_L < 0.75",
      "high_gte_0p75": "rho_L >= 0.75",
      "not_calculated": "missing R_neck or load"
    }
